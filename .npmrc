# Bloqueia instalação em versões de Node fora do campo "engines".
engine-strict=true
# Novas dependências entram com versão exata (sem ^ ou ~).
save-exact=true
# Proteção de cadeia de suprimentos: nenhum script de install/postinstall
# de pacotes de terceiros é executado. (O sharp usa binários pré-compilados.)
ignore-scripts=true
fund=false
