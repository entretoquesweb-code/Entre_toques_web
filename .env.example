# Copie para .env.local e ajuste. Nunca versione arquivos .env reais.

# URL pública definitiva do site (usada em canonical, Open Graph, sitemap e robots).
# Na Vercel, se não for definida, usa automaticamente o domínio de produção do projeto.
SITE_URL=https://www.entretoques.com.br

# Opcional: verificação do Google Search Console pela meta tag (método "Tag HTML").
# Cole só o valor do atributo content. Com domínio próprio, prefira verificar pelo DNS.
GOOGLE_SITE_VERIFICATION=
